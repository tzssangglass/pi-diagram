{
  "name": "@tzssangglass/pi-diagram",
  "version": "0.1.0",
  "description": "pi extension: render architecture/flow diagrams from declarative JSON with asynchronous child-process rendering and bounded inline playback",
  "type": "module",
  "license": "MIT",
  "author": "kurt tu <tzssangglass@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tzssangglass/pi-diagram.git"
  },
  "homepage": "https://github.com/tzssangglass/pi-diagram",
  "bugs": "https://github.com/tzssangglass/pi-diagram/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "diagram",
    "visualization",
    "architecture"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "scripts"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@earendil-works/pi-tui": "^0.86.1",
    "typebox": "^1.3.34"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "@google/genai@2.21.0": true
  }
}
